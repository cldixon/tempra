---
/**
 * Every page: the wordmark and the way into the app, the page as one sheet, and the footer. The
 * look is the app's (take 3, TEMPRA-110), all of it from the shared design package's public pages
 * (`public.css`); the site adds no styles of its own.
 */
import "@tempra/design/tempra.css";

interface Props {
  title: string;
  description: string;
  /** Keep the page out of search results (the 404 page). */
  noindex?: boolean;
}

const { title, description, noindex = false } = Astro.props;
const APP = "https://app.tempra.dev";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />}
  </head>
  <body class="ground public">
    <header class="public-head">
      <a class="wordmark" href="/"><span class="wordmark-tile" aria-hidden="true">T</span>Tempra</a>
      <nav class="public-nav" aria-label="Main">
        <a href={`${APP}/sign-in`}>Sign in</a>
        <a class="button primary" href={`${APP}/sign-in`}>Get started</a>
      </nav>
    </header>
    <main class="public-sheet">
      <slot />
    </main>
    <footer class="public-foot">
      <a href="/terms">Terms</a>
      <a href="/privacy">Privacy</a>
      <a href="https://github.com/cldixon/tempra">GitHub</a>
    </footer>
  </body>
</html>
